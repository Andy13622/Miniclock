<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cute Weather Clock V4</title>
<style>
:root{--ink:#4a3b52;--sub:#7d6f86;--card:rgba(255,255,255,.6);--line:rgba(74,59,82,.12);--acc:#ff7aa2;--ov:rgba(0,0,0,0);--g1:#cfe8ff;--g2:#ffe6c7;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--ink:#f5eefa;--sub:#c3b5cf;--card:rgba(24,20,40,.55);--line:rgba(255,255,255,.14);--ov:rgba(12,10,30,.62)}}
:root[data-theme="dark"]{color-scheme:dark;--ink:#f5eefa;--sub:#c3b5cf;--card:rgba(24,20,40,.55);--line:rgba(255,255,255,.14);--ov:rgba(12,10,30,.62)}
*{box-sizing:border-box}
html,body{margin:0}
body{min-height:100vh;font-family:"Nunito","Segoe UI",system-ui,sans-serif;color:var(--ink);background:linear-gradient(160deg,var(--g1),var(--g2));background-attachment:fixed;transition:background .6s}
body::after{content:"";position:fixed;inset:0;background:var(--ov);pointer-events:none;z-index:0}
main{position:relative;z-index:1;max-width:520px;margin:0 auto;padding:16px;display:grid;gap:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:18px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.hero{display:grid;grid-template-columns:1fr auto;align-items:center;gap:6px}
.greet{font-size:14px;color:var(--sub);font-weight:700}
.time{font-size:clamp(44px,15vw,68px);font-weight:900;line-height:1;letter-spacing:-1px;font-variant-numeric:tabular-nums}
.time small{font-size:.38em;color:var(--acc);margin-left:4px}
.date{margin-top:6px;font-weight:800;font-size:16px}
#icon{width:clamp(96px,30vw,130px);height:auto;filter:drop-shadow(0 6px 8px rgba(0,0,0,.12))}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px;flex-wrap:wrap}
.temp{font-size:34px;font-weight:900}
.cond{font-weight:800;color:var(--sub)}
.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.pill{background:var(--line);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 8px;margin-top:8px}
.chip{flex:0 0 auto;border:2px solid transparent;background:var(--line);color:var(--ink);border-radius:18px;padding:6px 8px 4px;font:inherit;font-size:11px;font-weight:800;cursor:pointer;text-align:center;min-width:64px}
.chip svg{width:38px;height:38px;display:block;margin:0 auto 2px}
.chip.on{border-color:var(--acc);background:var(--card)}
.tools{display:flex;gap:6px;flex-wrap:wrap}
button.t{border:0;background:var(--line);color:var(--ink);border-radius:999px;padding:6px 11px;font:inherit;font-size:12px;font-weight:800;cursor:pointer;transition:transform .15s,background .2s}
button.t:active{transform:scale(.96)}
button.t.active{background:var(--acc);color:#fff}
.loc-bar{margin-top:10px;padding:8px 12px;border-radius:16px;background:var(--line);font-size:12px;font-weight:700;display:none;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.loc-bar.show{display:flex}
.kmb-box{display:flex;gap:8px;align-items:center;margin-top:8px}
.kmb-box input{flex:1;border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:8px 14px;font:inherit;font-size:13px;font-weight:700;outline:none;text-transform:uppercase}
.kmb-box input:focus{border-color:var(--acc)}
.kmb-box button{border:0;background:var(--acc);color:#fff;border-radius:999px;padding:8px 16px;font:inherit;font-size:13px;font-weight:800;cursor:pointer;white-space:nowrap}
.kmb-res{margin-top:10px;font-size:12px;display:none}
.kmb-res.show{display:block}
.kmb-status{padding:7px 11px;border-radius:12px;background:var(--line);font-weight:700;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.kmb-badge{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:800;background:var(--card)}
.kmb-dot{width:7px;height:7px;border-radius:50%;background:#22c55e;display:inline-block}
.kmb-dot.warn{background:#f59e0b}
.kmb-dot.err{background:#ef4444}
.kmb-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.kmb-tab{border:1.5px solid transparent;background:var(--line);color:var(--ink);border-radius:12px;padding:5px 10px;font:inherit;font-size:11px;font-weight:800;cursor:pointer;text-align:left}
.kmb-tab.on{border-color:var(--acc);background:var(--card)}
.kmb-route{background:var(--line);border-radius:16px;padding:10px 12px;margin-top:8px}
.kmb-route-hdr{display:flex;justify-content:space-between;align-items:center;gap:6px;font-weight:800}
.kmb-stops{margin-top:6px;max-height:220px;overflow-y:auto;display:grid;gap:4px}
.kmb-stop{display:flex;justify-content:space-between;align-items:center;padding:6px 9px;border-radius:10px;background:var(--card);font-size:11px;gap:6px}
.kmb-stop-name{line-height:1.3}
.kmb-stop-tc{display:block;font-size:10px;color:var(--sub);font-weight:700}
.kmb-eta-list{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end;flex-shrink:0}
.kmb-eta{background:var(--line);color:var(--acc);font-weight:900;padding:2px 6px;border-radius:8px;white-space:nowrap}
.kmb-eta.first{background:var(--acc);color:#fff}
.kmb-frame-wrap{margin-top:8px;border-radius:14px;overflow:hidden;border:1px solid var(--line);background:#fff}
.kmb-frame-wrap iframe{width:100%;height:340px;border:0;display:block}
.mh{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.mh b{font-size:17px;cursor:pointer}
.mh button{border:0;background:var(--line);color:var(--ink);width:34px;height:34px;border-radius:50%;font-size:16px;cursor:pointer}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.dow{font-size:11px;font-weight:800;color:var(--sub);padding-bottom:4px}
.d{aspect-ratio:1;display:grid;place-items:center;border-radius:50%;font-size:14px;font-weight:700}
.d.o{opacity:.3}
.d.we{color:var(--acc)}
.d.today{background:var(--acc);color:#fff;font-weight:900;box-shadow:0 4px 10px rgba(255,122,162,.45)}
.note{font-size:11px;color:var(--sub);text-align:center;margin:8px 0 0}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes bob{50%{transform:translateY(-4px)}}
@keyframes fall{0%{transform:translateY(-6px);opacity:0}30%{opacity:1}100%{transform:translateY(14px);opacity:0}}
@keyframes blink{50%{opacity:.2}}
.spin{transform-origin:50px 50px;animation:spin 18s linear infinite}
.bob{animation:bob 3s ease-in-out infinite}
.fall{animation:fall 1.3s linear infinite}
.blink{animation:blink 2s infinite}
</style>
</head>
<body>
<main>
  <section class="card">
    <div class="hero">
      <div>
        <div class="greet" id="greet"></div>
        <div class="time" id="time"></div>
        <div class="date" id="date"></div>
      </div>
      <svg id="icon" viewBox="0 0 100 100" aria-hidden="true"></svg>
    </div>
    <div class="row">
      <div><span class="temp" id="temp"></span> <span class="cond" id="cond"></span></div>
      <div class="tools">
        <button class="t" id="twc" title="Sync weather from The Weather Channel">🌤️ Weather Ch.</button>
        <button class="t" id="gps" title="Track city via GPS">📍 GPS</button>
        <button class="t" id="u">°C / °F</button>
        <button class="t" id="f">12h / 24h</button>
      </div>
    </div>
    <div class="loc-bar" id="locBar">
      <span id="locText">Ready</span>
      <div style="display:flex;gap:6px;align-items:center">
        <a id="twcLink" href="https://weather.com/" target="_blank" rel="noopener noreferrer" style="color:var(--acc);font-weight:800;text-decoration:none;display:none">weather.com ↗</a>
        <button class="t" id="locStop" style="padding:3px 8px;font-size:11px">Clear</button>
      </div>
    </div>
    <div class="pills" id="pills"></div>
    <div class="chips" id="chips"></div>
    <p class="note">Time and date are live. Tap a weather mood to preview the icons.</p>
  </section>

  <section class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;flex-wrap:wrap">
      <span style="font-size:13px;font-weight:800;color:var(--sub)">🚌 KMB.hk Bus Tracker</span>
      <div style="display:flex;gap:6px">
        <button class="t" id="kmbToggleWeb" style="display:none;padding:3px 9px;font-size:11px">🌐 KMB.hk Live Map</button>
        <button class="t" id="kmbRefresh" style="display:none;padding:3px 9px;font-size:11px">↻ Refresh</button>
      </div>
    </div>
    <form class="kmb-box" id="kmbForm">
      <input type="text" id="kmbInput" placeholder="Enter KMB route (e.g. 1A, 6, 968, 270A)" maxlength="10" aria-label="KMB Bus Number" required>
      <button type="submit">Track</button>
    </form>
    <div class="kmb-res" id="kmbRes"></div>
  </section>

  <section class="card">
    <div class="mh"><button id="pv" aria-label="Previous month">‹</button><b id="mt" title="Back to today"></b><button id="nx" aria-label="Next month">›</button></div>
    <div class="grid" id="cal"></div>
  </section>
</main>
<script>
const W={
 sunny:{n:'Sunny',t:27,h:45,w:10,g:['#ffe29a','#ffb88c']},
 partly:{n:'Partly cloudy',t:24,h:55,w:12,g:['#cfe8ff','#ffe6c7']},
 cloudy:{n:'Cloudy',t:21,h:70,w:14,g:['#dfe6ee','#c3cedd']},
 rain:{n:'Rainy',t:18,h:85,w:16,g:['#bcd4ea','#9db6d3']},
 storm:{n:'Thunder',t:20,h:90,w:28,g:['#b4b0d6','#8a90b8']},
 snow:{n:'Snowy',t:-2,h:80,w:9,g:['#e6f1ff','#c9dcf5']},
 fog:{n:'Foggy',t:12,h:95,w:5,g:['#e4e4ea','#cfd3dc']}
};
let key='partly',F=false,H12=true,view=new Date();view.setDate(1);
let customTemp=null,customHum=null,customWind=null,customCond=null;
let gpsWatchId=null,lastCoords=null,lastCity='Hong Kong';
const $=id=>document.getElementById(id);
const face=(x,y)=>`<g stroke-linecap="round"><circle cx="${x-6}" cy="${y}" r="2.3" fill="#5b4636"/><circle cx="${x+6}" cy="${y}" r="2.3" fill="#5b4636"/><path d="M${x-3} ${y+4}q3 3 6 0" stroke="#5b4636" stroke-width="1.6" fill="none"/><circle cx="${x-11}" cy="${y+3}" r="2.6" fill="#ff9fb0" opacity=".75"/><circle cx="${x+11}" cy="${y+3}" r="2.6" fill="#ff9fb0" opacity=".75"/></g>`;
const cloud=(c='#fff',dx=0,dy=0,f=true)=>`<g transform="translate(${dx} ${dy})"><rect x="20" y="46" width="60" height="24" rx="12" fill="${c}"/><circle cx="40" cy="46" r="15" fill="${c}"/><circle cx="59" cy="41" r="19" fill="${c}"/>${f?face(50,58):''}</g>`;
const sun=(x=0,y=0,s=1,f=true)=>{let r='';for(let i=0;i<8;i++)r+=`<line x1="50" y1="14" x2="50" y2="22" transform="rotate(${i*45} 50 50)" stroke="#ffb703" stroke-width="4.5" stroke-linecap="round"/>`;return `<g transform="translate(${x} ${y}) scale(${s})"><g class="spin">${r}</g><circle cx="50" cy="50" r="22" fill="#ffd23f"/>${f?face(50,52):''}</g>`};
const moon=(f=true)=>`<path d="M64 18a32 32 0 1 0 22 46a27 27 0 0 1-22-46z" fill="#ffe9a8"/>${f?face(46,56):''}<g class="blink" fill="#ffe9a8"><circle cx="78" cy="22" r="2"/><circle cx="88" cy="40" r="1.6"/><circle cx="20" cy="22" r="1.8"/></g>`;
const drops=(n)=>{let s='';for(let i=0;i<n;i++)s+=`<path class="fall" style="animation-delay:${i*.35}s" d="M${34+i*16} 76q-4 7 0 9q4-2 0-9z" fill="#5aa9f0"/>`;return s};
const flakes=()=>[34,50,66].map((x,i)=>`<text class="fall" style="animation-delay:${i*.45}s" x="${x}" y="82" font-size="11" text-anchor="middle" fill="#8fc2ff">❄</text>`).join('');
function ic(k,night){
 if(k==='sunny')return night?moon():sun();
 if(k==='partly')return (night?`<g transform="translate(-6 -8) scale(.7)">${moon(false)}</g>`:sun(-10,-14,.7,false))+`<g class="bob">${cloud('#fff',4,6)}</g>`;
 if(k==='cloudy')return `<g class="bob">${cloud('#e9eef5',0,-2)}</g>`;
 if(k==='rain')return `<g class="bob">${cloud('#d5e1ee',0,-8)}</g>${drops(3)}`;
 if(k==='storm')return `<g class="bob">${cloud('#9aa5b8',0,-8)}</g><polygon class="blink" points="52,64 42,80 50,80 46,94 62,74 53,74 58,64" fill="#ffd23f" stroke="#ffb703" stroke-width="1.5" stroke-linejoin="round"/>`;
 if(k==='snow')return `<g class="bob">${cloud('#f4f9ff',0,-8)}</g>${flakes()}`;
 return `<g class="bob">${cloud('#e6e6ee',0,-8)}</g><g stroke="#b9bccb" stroke-width="3.5" stroke-linecap="round"><line x1="26" y1="80" x2="74" y2="80"/><line x1="34" y1="88" x2="82" y2="88"/></g>`;
}
const pad=n=>String(n).padStart(2,'0');
const DAYS=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const MON=['January','February','March','April','May','June','July','August','September','October','November','December'];
function tick(){
 const d=new Date(),h=d.getHours(),night=h>=19||h<6;
 let hh=H12?(h%12||12):pad(h);
 $('time').innerHTML=`${hh}:${pad(d.getMinutes())}<small>${pad(d.getSeconds())}${H12?(h<12?' AM':' PM'):''}</small>`;
 $('date').textContent=`${DAYS[d.getDay()]}, ${MON[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
 $('greet').textContent=h<5?'Sweet dreams ✨':h<12?'Good morning ☀️':h<18?'Good afternoon 🌼':'Good evening 🌙';
 if($('icon').dataset.k!==key+night){
  $('icon').dataset.k=key+night;
  $('icon').innerHTML=ic(key,night);
  $('cond').textContent=customCond||((key==='sunny'&&night)?'Clear night':W[key].n);
 }
 const nm=pad(d.getMonth())+d.getDate();if(tick.day!==nm){tick.day=nm;cal()}
}
function weather(){
 const w=W[key];
 const tVal=customTemp!==null?customTemp:w.t;
 const hVal=customHum!==null?customHum:w.h;
 const wVal=customWind!==null?customWind:w.w;
 $('temp').textContent=F?Math.round(tVal*9/5+32)+'°F':Math.round(tVal)+'°C';
 $('pills').innerHTML=`<span class="pill">💧 ${Math.round(hVal)}%</span><span class="pill">🍃 ${F?Math.round(wVal*.621)+' mph':Math.round(wVal)+' km/h'}</span>`;
 $('chips').innerHTML=Object.keys(W).map(k=>`<button class="chip ${k===key?'on':''}" data-k="${k}"><svg viewBox="0 0 100 100">${ic(k,false)}</svg>${W[k].n}</button>`).join('');
 document.documentElement.style.setProperty('--g1',w.g[0]);document.documentElement.style.setProperty('--g2',w.g[1]);
 $('icon').dataset.k='';tick();
}
function cal(){
 const y=view.getFullYear(),m=view.getMonth(),t=new Date();
 $('mt').textContent=`${MON[m]} ${y}`;
 const first=new Date(y,m,1).getDay(),dim=new Date(y,m+1,0).getDate(),prev=new Date(y,m,0).getDate();
 let s=['S','M','T','W','T','F','S'].map(x=>`<div class="dow">${x}</div>`).join('');
 for(let i=0;i<42;i++){
  let n=i-first+1,o=false;
  if(n<1){n+=prev;o=true}else if(n>dim){n-=dim;o=true}
  const col=i%7,isT=!o&&y===t.getFullYear()&&m===t.getMonth()&&n===t.getDate();
  s+=`<div class="d${o?' o':''}${(col===0||col===6)&&!isT?' we':''}${isT?' today':''}">${n}</div>`;
 }
 $('cal').innerHTML=s;
}
$('chips').onclick=e=>{
 const b=e.target.closest('.chip');
 if(b){
  key=b.dataset.k;
  customTemp=null;customHum=null;customWind=null;customCond=null;
  $('twc').classList.remove('active');
  weather();
 }
};
$('u').onclick=()=>{F=!F;weather()};
$('f').onclick=()=>{H12=!H12;tick()};
$('pv').onclick=()=>{view.setMonth(view.getMonth()-1);cal()};
$('nx').onclick=()=>{view.setMonth(view.getMonth()+1);cal()};
$('mt').onclick=()=>{view=new Date();view.setDate(1);cal()};

function mapWmoToKey(code){
 if(code===0||code===1)return 'sunny';
 if(code===2)return 'partly';
 if(code===3)return 'cloudy';
 if(code===45||code===48)return 'fog';
 if((code>=51&&code<=67)||(code>=80&&code<=82))return 'rain';
 if((code>=71&&code<=77)||code===85||code===86)return 'snow';
 if(code>=95)return 'storm';
 return 'partly';
}
function mapTwcIconToKey(iconCode,phrase=''){
 const p=phrase.toLowerCase();
 if(p.includes('thunder')||p.includes('storm'))return 'storm';
 if(p.includes('snow')||p.includes('flurr')||p.includes('sleet')||p.includes('ice'))return 'snow';
 if(p.includes('rain')||p.includes('shower')||p.includes('drizzle'))return 'rain';
 if(p.includes('fog')||p.includes('mist')||p.includes('haze'))return 'fog';
 if(p.includes('partly')||p.includes('mostly sunny')||p.includes('mostly clear'))return 'partly';
 if(p.includes('cloud')||p.includes('overcast'))return 'cloudy';
 if(p.includes('sun')||p.includes('clear')||p.includes('fair'))return 'sunny';
 const c=Number(iconCode);
 if([0,1,2,3,4,17,35,37,38,47].includes(c))return 'storm';
 if([5,6,7,8,10,13,14,15,16,18,41,42,43,46].includes(c))return 'snow';
 if([9,11,12,39,40,45].includes(c))return 'rain';
 if([19,20,21,22].includes(c))return 'fog';
 if([26,27,28].includes(c))return 'cloudy';
 if([29,30,33,34].includes(c))return 'partly';
 if([31,32,36].includes(c))return 'sunny';
 return 'partly';
}

// 1-Button Weather Channel Data Sync
async function syncWeatherChannel(){
 const btn=$('twc');
 btn.classList.add('active');
 btn.textContent='🌤️ Syncing...';
 $('locBar').classList.add('show');
 $('locText').textContent='🌤️ Connecting to The Weather Channel...';
 let lat=lastCoords?lastCoords.lat:22.3193;
 let lon=lastCoords?lastCoords.lon:114.1694;
 if(!lastCoords&&navigator.geolocation){
  try{
   const pos=await new Promise((res,rej)=>navigator.geolocation.getCurrentPosition(res,rej,{timeout:5000}));
   lat=pos.coords.latitude;lon=pos.coords.longitude;
   lastCoords={lat,lon};
  }catch(_){}
 }
 const twcPageUrl=`https://weather.com/weather/today/l/${lat.toFixed(2)},${lon.toFixed(2)}`;
 $('twcLink').href=twcPageUrl;
 $('twcLink').style.display='inline';
 try{
  try{
   const gRes=await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}&accept-language=en`);
   if(gRes.ok){
    const g=await gRes.json();const a=g.address||{};
    lastCity=a.city||a.town||a.village||a.suburb||a.county||a.state||lastCity;
   }
  }catch(_){}

  const twcApi=`https://api.weather.com/v3/wx/observations/current?geocode=${lat.toFixed(4)},${lon.toFixed(4)}&units=m&language=en-US&format=json&apiKey=e1f10a1e78da46f5b10a1e78da96f525`;
  let synced=false;
  try{
   const r=await fetch(twcApi);
   if(r.ok){
    const d=await r.json();
    if(typeof d.temperature==='number'){
     key=mapTwcIconToKey(d.iconCode,d.wxPhraseLong||d.wxPhraseMedium||'');
     customTemp=d.temperature;
     customHum=d.relativeHumidity??55;
     customWind=d.windSpeed??10;
     customCond=d.wxPhraseLong||d.wxPhraseMedium||W[key].n;
     synced=true;
     $('locText').textContent=`🌤️ The Weather Channel (${lastCity}): ${Math.round(customTemp)}°C, ${customCond}`;
    }
   }
  }catch(_){}

  if(!synced){
   const fb=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m`);
   if(!fb.ok)throw new Error('Weather feed unavailable');
   const wx=await fb.json();
   const c=wx.current;
   key=mapWmoToKey(c.weather_code);
   customTemp=c.temperature_2m;
   customHum=c.relative_humidity_2m;
   customWind=c.wind_speed_10m;
   customCond=W[key].n;
   $('locText').textContent=`🌤️ Weather Sync (${lastCity}): ${Math.round(customTemp)}°C, ${customCond}`;
  }
  weather();
  btn.textContent='🌤️ Weather Ch. ✓';
 }catch(err){
  btn.classList.remove('active');
  btn.textContent='🌤️ Weather Ch.';
  $('locText').textContent=`⚠️ Weather sync failed: ${err.message}`;
 }
}
$('twc').onclick=syncWeatherChannel;

// GPS City Location Tracking
async function updateCityFromCoords(lat,lon){
 lastCoords={lat,lon};
 $('locBar').classList.add('show');
 $('locText').textContent=`📍 ${lat.toFixed(4)}, ${lon.toFixed(4)} — resolving city...`;
 try{
  const [geoRes,wxRes]=await Promise.all([
   fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}&accept-language=en`),
   fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m`)
  ]);
  let cityLabel=`${lat.toFixed(3)}, ${lon.toFixed(3)}`;
  if(geoRes.ok){
   const g=await geoRes.json();
   const a=g.address||{};
   const city=a.city||a.town||a.village||a.suburb||a.county||a.state||'Unknown City';
   const country=a.country_code?a.country_code.toUpperCase():'';
   lastCity=city;
   cityLabel=`${city}${country?', '+country:''}`;
  }
  if(wxRes.ok){
   const wx=await wxRes.json();
   if(wx.current){
    key=mapWmoToKey(wx.current.weather_code);
    customTemp=wx.current.temperature_2m;
    customHum=wx.current.relative_humidity_2m;
    customWind=wx.current.wind_speed_10m;
    customCond=null;
    weather();
   }
  }
  $('twcLink').href=`https://weather.com/weather/today/l/${lat.toFixed(2)},${lon.toFixed(2)}`;
  $('twcLink').style.display='inline';
  $('locText').textContent=`📍 Tracking: ${cityLabel} (${lat.toFixed(3)}, ${lon.toFixed(3)})`;
 }catch(err){
  $('locText').textContent=`📍 Coordinates: ${lat.toFixed(4)}, ${lon.toFixed(4)}`;
 }
}
function stopGps(){
 if(gpsWatchId!==null&&navigator.geolocation){
  navigator.geolocation.clearWatch(gpsWatchId);
  gpsWatchId=null;
 }
 $('gps').classList.remove('active');
 $('gps').textContent='📍 GPS';
 $('locBar').classList.remove('show');
 $('twcLink').style.display='none';
}
$('gps').onclick=()=>{
 if(gpsWatchId!==null){stopGps();return;}
 if(!navigator.geolocation){
  $('locBar').classList.add('show');
  $('locText').textContent='📍 Geolocation not supported by this browser.';
  return;
 }
 $('gps').classList.add('active');
 $('gps').textContent='📍 Tracking';
 $('locBar').classList.add('show');
 $('locText').textContent='📍 Acquiring GPS signal...';
 gpsWatchId=navigator.geolocation.watchPosition(
  pos=>updateCityFromCoords(pos.coords.latitude,pos.coords.longitude),
  err=>{$('locText').textContent=`📍 GPS error: ${err.message}`;$('gps').classList.remove('active');$('gps').textContent='📍 GPS';gpsWatchId=null;},
  {enableHighAccuracy:true,maximumAge:15000,timeout:15000}
 );
};
