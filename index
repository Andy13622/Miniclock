// KMB.hk Bus Tracker (Direct Route Probe + Multi-Source KMB.hk / data.etabus.gov.hk / hkbus Fallback)
let kmbStopsCache=null,kmbRoutesCache=null,lastKmbRoute='',showKmbWebFrame=false;
const KMB_BASES=[
 'https://data.etabus.gov.hk/v1/transport/kmb',
 'https://data.kmb.hk/v1/transport/kmb'
];

async function fetchJsonWithFallback(path){
 let lastErr=null;
 for(const base of KMB_BASES){
  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(),9000);
  try{
   const res=await fetch(`${base}${path}`,{signal:ctrl.signal,cache:'no-store'});
   clearTimeout(timer);
   if(!res.ok)throw new Error(`HTTP ${res.status}`);
   const json=await res.json();
   if(json&&json.data!==undefined)return {json,source:base.includes('kmb.hk')?'KMB.hk':'KMB Open Data'};
  }catch(err){
   clearTimeout(timer);
   lastErr=err;
  }
 }
 throw lastErr||new Error('Connection failed');
}

async function getKmbRoutes(){
 if(kmbRoutesCache)return kmbRoutesCache;
 const {json}=await fetchJsonWithFallback('/route/');
 kmbRoutesCache=Array.isArray(json.data)?json.data:[];
 return kmbRoutesCache;
}

async function getKmbStopsMap(){
 if(kmbStopsCache)return kmbStopsCache;
 const {json}=await fetchJsonWithFallback('/stop');
 const map={};
 (Array.isArray(json.data)?json.data:[]).forEach(s=>{map[s.stop]=s;});
 kmbStopsCache=map;
 return map;
}

// Fast direct probe for a specific route (works even if full /route/ list is slow or large)
async function probeRouteDirect(route){
 const dirs=['outbound','inbound'];
 const svcs=['1','2','3','4','5'];
 const tasks=[];
 for(const dir of dirs){
  for(const svc of svcs){
   tasks.push(
    fetchJsonWithFallback(`/route/${route}/${dir}/${svc}`)
     .then(({json})=>{
      const d=json.data;
      if(d&&d.route===route)return d;
      return null;
     })
     .catch(()=>null)
   );
  }
 }
 const results=(await Promise.all(tasks)).filter(Boolean);
 // Deduplicate by bound + service_type
 const seen=new Set();
 return results.filter(r=>{
  const id=`${r.bound}_${r.service_type}`;
  if(seen.has(id))return false;
  seen.add(id);
  return true;
 });
}

function fmtEtaMinutes(etaStr){
 if(!etaStr)return null;
 const t=new Date(etaStr);
 if(isNaN(t.getTime()))return null;
 const diff=Math.round((t-new Date())/60000);
 if(diff<=0)return 'Arriving';
 return `${diff} min`;
}

function renderKmbWebEmbed(route,officialUrl){
 return `<div class="kmb-frame-wrap"><iframe src="${officialUrl}" title="KMB.hk Official Route ${route}" loading="lazy" referrerpolicy="no-referrer"></iframe></div>`;
}

async function searchKmbRoute(rawRoute){
 const route=rawRoute.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');
 if(!route)return;
 lastKmbRoute=route;
 $('kmbInput').value=route;
 $('kmbRefresh').style.display='inline-block';
 $('kmbToggleWeb').style.display='inline-block';
 const officialUrl=`https://search.kmb.hk/KMBWebSite/?action=routesearch&route=${encodeURIComponent(route)}&lang=en`;
 const box=$('kmbRes');
 box.classList.add('show');
 box.innerHTML=`<div class="kmb-status"><span class="kmb-badge"><span class="kmb-dot warn"></span> KMB.hk: Searching <b>${route}</b>...</span><a href="${officialUrl}" target="_blank" rel="noopener noreferrer" style="color:var(--acc);font-weight:800;text-decoration:none">KMB.hk Official ↗</a></div>`;

 try{
  // Step 1: Resolve route directions quickly via direct endpoint or cached route list
  let matches=[];
  if(kmbRoutesCache){
   matches=kmbRoutesCache.filter(r=>String(r.route).toUpperCase()===route);
  }
  if(!matches.length){
   matches=await probeRouteDirect(route);
  }
  if(!matches.length){
   const allRoutes=await getKmbRoutes();
   matches=allRoutes.filter(r=>String(r.route).toUpperCase()===route);
  }

  // Prefer service_type '1' if available, otherwise show all active service types
  const regular=matches.filter(r=>String(r.service_type)==='1');
  if(regular.length)matches=regular;

  if(!matches.length){
   box.innerHTML=`<div class="kmb-status"><span class="kmb-badge"><span class="kmb-dot err"></span> KMB.hk: Route <b>${route}</b> not found</span><a href="${officialUrl}" target="_blank" rel="noopener noreferrer" style="color:var(--acc);font-weight:800;text-decoration:none">Search on KMB.hk ↗</a></div>${showKmbWebFrame?renderKmbWebEmbed(route,officialUrl):''}`;
   return;
  }

  // Sort outbound first, then inbound
  matches.sort((a,b)=>(a.bound===b.bound?0:(a.bound==='O'?-1:1)));

  // Step 2: Fetch stops dictionary (with graceful fallback to individual stop lookup if full list fails)
  let stopsMap={};
  try{
   stopsMap=await getKmbStopsMap();
  }catch(_){}

  const nowStr=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  let html=`<div class="kmb-status"><span class="kmb-badge"><span class="kmb-dot"></span> KMB.hk Live • Route ${route} (${nowStr})</span><a href="${officialUrl}" target="_blank" rel="noopener noreferrer" style="color:var(--acc);font-weight:800;text-decoration:none">Open KMB.hk ↗</a></div>`;
  if(showKmbWebFrame){
   html+=renderKmbWebEmbed(route,officialUrl);
  }

  for(const m of matches){
   const dir=m.bound==='O'?'outbound':'inbound';
   const svc=String(m.service_type||'1');
   const [rsWrap,etaWrap]=await Promise.all([
    fetchJsonWithFallback(`/route-stop/${route}/${dir}/${svc}`),
    fetchJsonWithFallback(`/route-eta/${route}/${svc}`).catch(()=>({json:{data:[]}}))
   ]);
   const rsData=Array.isArray(rsWrap.json.data)?rsWrap.json.data:[];
   const etaData=Array.isArray(etaWrap.json.data)?etaWrap.json.data:[];

   // If bulk stop list failed earlier, resolve stop names individually in parallel
   if(!Object.keys(stopsMap).length&&rsData.length){
    await Promise.all(rsData.map(async st=>{
     try{
      const sRes=await fetchJsonWithFallback(`/stop/${st.stop}`);
      if(sRes.json&&sRes.json.data)stopsMap[st.stop]=sRes.json.data;
     }catch(_){}
    }));
   }

   const etasBySeq={};
   etaData.filter(x=>x.dir===m.bound).forEach(x=>{
    const keySeq=String(x.seq);
    if(!etasBySeq[keySeq])etasBySeq[keySeq]=[];
    etasBySeq[keySeq].push(x);
   });

   const stopsHtml=rsData.map(st=>{
    const info=stopsMap[st.stop]||{};
    const list=(etasBySeq[String(st.seq)]||[]).sort((a,b)=>Number(a.eta_seq)-Number(b.eta_seq));
    const pills=list.map((item,idx)=>{
     const txt=fmtEtaMinutes(item.eta);
     if(!txt)return '';
     return `<span class="kmb-eta${idx===0?' first':''}">${txt}</span>`;
    }).filter(Boolean).join('');
    const fallbackRmk=(list[0]&&(list[0].rmk_en||list[0].rmk_tc))||(list.length?'Scheduled':'No bus');
    const nameEn=info.name_en||`Stop ${st.seq}`;
    const nameTc=info.name_tc?`<span class="kmb-stop-tc">${info.name_tc}</span>`:'';
    return `<div class="kmb-stop"><div class="kmb-stop-name"><b>${st.seq}.</b> ${nameEn}${nameTc}</div><div class="kmb-eta-list">${pills||`<span style="color:var(--sub);font-weight:700">${fallbackRmk}</span>`}</div></div>`;
   }).join('');

   const svcTag=svc!=='1'?` • Special Svc ${svc}`:'';
   const dirLabel=m.bound==='O'?'Outbound':'Inbound';
   html+=`<div class="kmb-route"><div class="kmb-route-hdr"><span>${m.orig_en} → ${m.dest_en}</span><span style="font-size:11px;color:var(--sub)">${dirLabel}${svcTag} (${rsData.length} stops)</span></div><div class="kmb-stops">${stopsHtml||'<div class="kmb-stop">No stop data returned.</div>'}</div></div>`;
  }
  box.innerHTML=html;
 }catch(err){
  box.innerHTML=`<div class="kmb-status"><span class="kmb-badge"><span class="kmb-dot err"></span> KMB.hk Status: Connection blocked/offline (${err.message||'Error'})</span><a href="${officialUrl}" target="_blank" rel="noopener noreferrer" style="color:var(--acc);font-weight:800;text-decoration:none">Open KMB.hk Website ↗</a></div>${renderKmbWebEmbed(route,officialUrl)}`;
 }
}

$('kmbForm').onsubmit=e=>{e.preventDefault();searchKmbRoute($('kmbInput').value)};
$('kmbRefresh').onclick=()=>{if(lastKmbRoute)searchKmbRoute(lastKmbRoute)};
$('kmbToggleWeb').onclick=()=>{
 showKmbWebFrame=!showKmbWebFrame;
 $('kmbToggleWeb').classList.toggle('active',showKmbWebFrame);
 if(lastKmbRoute)searchKmbRoute(lastKmbRoute);
};

weather();cal();setInterval(tick,1000);
</script>
